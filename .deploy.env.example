# 部署目标（scripts/deploy.sh 读它）。
#
#     cp .deploy.env.example .deploy.env    # 然后填成你自己的机器
#
# `.deploy.env` 已 gitignore。**服务器地址刻意不写进脚本本身** —— 本仓库是公开的，
# 把生产机 IP 连同「这是演示站、用的是公开默认口令」一起写进 GitHub，
# 等于给扫描器递名单。地址只留在本机这个文件里。

DEPLOY_HOST=1.2.3.4
DEPLOY_USER=ubuntu
# 代码在服务器上的目录（compose 项目就在这一层）
DEPLOY_PATH=/opt/rag-kb
