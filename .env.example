# ===== 数据库（PostgreSQL + pgvector）=====
DATABASE_URL=postgresql+psycopg2://postgres:123456@localhost:5432/rag_kb

# ===== LLM（OpenAI 兼容接口，DeepSeek / 通义 / 本地 vLLM 均可）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# ===== Embedding（向量化）=====
# local          -> 本地 sentence-transformers 模型（EMBEDDING_MODEL）
# openai_compatible -> 在线 OpenAI 兼容 embedding 接口
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 本地模型未下载时，通过 hf-mirror 下载（HF 直连在国内常不可用）
HF_ENDPOINT=https://hf-mirror.com
# 维度需与 EMBEDDING_MODEL 一致：bge-small-zh-v1.5=512, bge-m3=1024, text-embedding-3-small=1536
EMBEDDING_DIM=512
# 在线 embedding 时使用（可选）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=

# ===== 分块 / 检索 =====
CHUNK_SIZE=500
OVERLAP=100
TOP_K=4
SIMILARITY_THRESHOLD=0.5

# ===== 上传 =====
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./data/uploads
