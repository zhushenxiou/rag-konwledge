# 配置模板：复制为 .env 后填入真实密钥
#
#     cp .env.example .env
#
# 这一个文件同时服务两种运行方式（本地 conda 开发 / 服务器 docker compose），
# 不需要两份模板 —— 因为三处真正会冲突的项由 docker-compose.yml 的 `environment:`
# 段**强制覆盖**，而不是靠这里写死：
#
#     项                  本机开发              容器里
#     -----------------   -------------------   ---------------------
#     DATABASE_URL        localhost:5432        db:5432（由 POSTGRES_* 拼出）
#     UPLOAD_DIR          ./data/uploads        /data/uploads
#     TEST_DATABASE_URL   rag_kb_test          空（必须空，见文件末尾）
#
# 也就是说：**服务器上真正必须改的只有 `POSTGRES_PASSWORD` 和三个 API Key**，
# 上面那些差异项一个都不用动。
#
# ⚠️ pydantic-settings 配的是 `extra="ignore"`：**键名拼错的项会被静默忽略**，
#    不报错、直接回落到默认值。所以「我改了配置但没生效」时，第一件事是核对拼写；
#    后端启动日志里那行脱敏摘要（`[entrypoint] 配置: ...`）是唯一能告诉你
#    进程**实际读到了什么**的东西 —— 别只看这个文件。

# ===== 数据库 =====
# 数据库连接串（PostgreSQL + pgvector）
# 本机开发连宿主机：容器里的那份由 compose 覆盖成 db:5432，不用改这里。
DATABASE_URL=postgresql+psycopg2://postgres:123456@localhost:5432/rag_kb

# ===== LLM（OpenAI 兼容接口）=====
# LLM 接口地址（OpenAI 兼容）
LLM_BASE_URL=https://api.deepseek.com/v1
# LLM 密钥（必填）
LLM_API_KEY=sk-xxxxxxxx
# LLM 模型名
LLM_MODEL=deepseek-chat
# 生成温度
LLM_TEMPERATURE=0.3

# ===== Embedding（千问 text-embedding-v4）=====
# Embedding 接口地址（DashScope）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Embedding 密钥（必填，DashScope）
EMBEDDING_API_KEY=sk-xxx
# Embedding 模型名
EMBEDDING_MODEL_NAME=text-embedding-v4
# 向量维度，须与模型输出 / 数据库 Vector 列一致
EMBEDDING_DIM=512
# 注：单请求条数上限无需配置（DashScope 是 10、v1/v2 是 25、OpenAI 是 2048），
# 适配器会在运行时探测并记忆，换厂商不用改任何东西。

# ===== 分块 / 检索 =====
# 分块大小（字符）
CHUNK_SIZE=500
# 分块重叠（字符）
OVERLAP=100
# 检索返回分块数
TOP_K=4
# 相似度阈值，低于判为无依据
SIMILARITY_THRESHOLD=0.5
# 每路召回候选数（需 > TOP_K）
BM25_RECALL_K=20
# RRF 平滑常数
RRF_K=60

# ===== 重排（qwen3-rerank，可选）=====
# 启用在线重排（失败自动回退）
RERANK_ENABLED=true
# 重排接口地址（DashScope）
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
# 重排密钥（同 Embedding 账号，留空跳过）
RERANK_API_KEY=sk-xxx
# 重排模型
RERANK_MODEL_NAME=qwen3-rerank
# 重排候选数（重排后取 TOP_K）
RERANK_CANDIDATES=10

# ===== 对话记忆（上下文窗口管理：历史压缩 + 关键信息抽取）=====
# 总开关；关掉则退化为纯单轮（不传历史，同旧版行为）
MEMORY_ENABLED=true
# 最近原文窗口估算 token 预算，超过触发滚动压缩（把旧轮折叠进摘要）
MEMORY_RECENT_TOKENS=1200
# 压缩时保留的最近完整对话轮数（不进摘要，保真）
MEMORY_RECENT_ROUNDS=2
# 关键事实条目上限（超限由 LLM 在更新时裁剪）
MEMORY_MAX_FACTS=20
# 每轮抽取关键事实（False → 仅压缩时抽取）
MEMORY_EXTRACT_EVERY_TURN=true
# 多轮时改写检索问题（指代消解；改写只用于检索，不改生成）
MEMORY_REWRITE_ENABLED=true

# ===== 上传 =====
# 上传大小限制（MB）
MAX_FILE_SIZE_MB=10
# 上传文件存储目录（容器里由 compose 覆盖成 /data/uploads，不用改这里）
UPLOAD_DIR=./data/uploads

# ===== 登录鉴权 =====
# 演示账号（明文），**所有环境统一为 zhuliang / zhuliang** —— 也正是 app/config.py
# 的默认值，所以这两行不写也能登进去。想换就改这两行，但要把结论说清楚：
# 本项目定位是演示，这套鉴权只防"误入"、不防"有意访问"，别放真实文档。
AUTH_USERNAME=zhuliang
AUTH_PASSWORD=zhuliang
# 登录 token 有效期（分钟）；token 存进程内存，后端重启即全体失效
AUTH_TOKEN_TTL_MINUTES=720
# 验证码有效期（秒）；验证码是一次性的（校验即作废）
CAPTCHA_TTL_SECONDS=120
# 【危险】仅本地自动化验收用：开启后取验证码接口会额外返回明文 code，验证码形同虚设。
# 默认 false；容器化部署（deploy/backend-entrypoint.sh）会拒绝以 true 启动。
AUTH_CAPTCHA_BYPASS=false

# ===== 测试库 =====
# 测试库连接串（pytest 独立库）；容器里由 compose 强制置空，不用改这里。
TEST_DATABASE_URL=postgresql+psycopg2://postgres:123456@localhost:5432/rag_kb_test

# ============================================================================
# ===== 服务器部署（docker compose）=====
# 本地开发整段都不用管 —— 上面那些配置已经够本机跑了。
# 部署步骤见 deploy.md。
# ============================================================================

# 仅供 compose 做变量插值：它用下面三项拼出**容器内**的 DATABASE_URL 指向 `db` 服务，
# 让口令只有**一个**来源 —— 否则「改了 POSTGRES_PASSWORD 忘了同步 DATABASE_URL」
# 是必然会发生的事故。所以改口令请改这里，改上面那个 DATABASE_URL 在容器里不生效。
#
# ★ 必须改掉，且**只用字母数字**：它会被拼进连接串 URL，
#   含 @ : / 等字符会破坏 URL 解析。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_alnum_password
# 预建业务库，让 init_db.py 里的 CREATE DATABASE 退化成幂等 no-op
POSTGRES_DB=rag_kb

# 前端（nginx）对宿主机的映射端口 —— 浏览器就访问 `http://<服务器IP>:82/`。
# 注意容器内 nginx 仍监听 80（`frontend/nginx.conf`），这只是宿主机侧映射。
# 云控制台安全组要放行同一端口，否则「服务器上 curl 127.0.0.1 通、外网打不开」。
HTTP_PORT=82

# ----- 构建期包索引（只影响 `docker compose build`，运行期不用）-----
# 不设就是官方源，**国内服务器上必须改**，否则构建慢到不可用：
#   官方 PyPI 文件 CDN 实测 ~34 KB/s（一个 19MB 的包要下 9 分钟）→ 国内镜像 3~8 秒
#   官方 npm registry 实测 ~227 KB/s                          → npmmirror 2.4 MB/s
# 这里给的是实测最快的一对（服务器在腾讯云上时 mirrors.cloud.tencent.com 走内网）。
# 改完要重建镜像才生效：docker compose build（见 deploy.md 第 0 节）。
# 备用：阿里云 https://mirrors.aliyun.com/pypi/simple/
#       清华   https://pypi.tuna.tsinghua.edu.cn/simple/
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple/
NPM_REGISTRY=https://registry.npmmirror.com
