# 配置模板：复制为 .env 后填入真实密钥
# ===== 数据库 =====
# 数据库连接串（PostgreSQL + pgvector）
DATABASE_URL=postgresql+psycopg2://postgres:123456@localhost:5432/rag_kb

# ===== LLM（OpenAI 兼容接口）=====
# LLM 接口地址（OpenAI 兼容）
LLM_BASE_URL=https://api.deepseek.com/v1
# LLM 密钥（必填）
LLM_API_KEY=sk-xxxxxxxx
# LLM 模型名
LLM_MODEL=deepseek-chat
# 生成温度
LLM_TEMPERATURE=0.3

# ===== Embedding（千问 text-embedding-v4）=====
# Embedding 接口地址（DashScope）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Embedding 密钥（必填，DashScope）
EMBEDDING_API_KEY=sk-xxx
# Embedding 模型名
EMBEDDING_MODEL_NAME=text-embedding-v4
# 向量维度，须与模型输出 / 数据库 Vector 列一致
EMBEDDING_DIM=512

# ===== 分块 / 检索 =====
# 分块大小（字符）
CHUNK_SIZE=500
# 分块重叠（字符）
OVERLAP=100
# 检索返回分块数
TOP_K=4
# 相似度阈值，低于判为无依据
SIMILARITY_THRESHOLD=0.5
# 每路召回候选数（需 > TOP_K）
BM25_RECALL_K=20
# RRF 平滑常数
RRF_K=60

# ===== 重排（qwen3-rerank，可选）=====
# 启用在线重排（失败自动回退）
RERANK_ENABLED=true
# 重排接口地址（DashScope）
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
# 重排密钥（同 Embedding 账号，留空跳过）
RERANK_API_KEY=sk-xxx
# 重排模型
RERANK_MODEL_NAME=qwen3-rerank
# 重排候选数（重排后取 TOP_K）
RERANK_CANDIDATES=10

# ===== 对话记忆（上下文窗口管理：历史压缩 + 关键信息抽取）=====
# 总开关；关掉则退化为纯单轮（不传历史，同旧版行为）
MEMORY_ENABLED=true
# 最近原文窗口估算 token 预算，超过触发滚动压缩（把旧轮折叠进摘要）
MEMORY_RECENT_TOKENS=1200
# 压缩时保留的最近完整对话轮数（不进摘要，保真）
MEMORY_RECENT_ROUNDS=2
# 关键事实条目上限（超限由 LLM 在更新时裁剪）
MEMORY_MAX_FACTS=20
# 每轮抽取关键事实（False → 仅压缩时抽取）
MEMORY_EXTRACT_EVERY_TURN=true
# 多轮时改写检索问题（指代消解；改写只用于检索，不改生成）
MEMORY_REWRITE_ENABLED=true

# ===== 上传 =====
# 上传大小限制（MB）
MAX_FILE_SIZE_MB=10
# 上传文件存储目录
UPLOAD_DIR=./data/uploads

# ===== 登录鉴权 =====
# 演示固定账号（明文）—— 公网部署前必须修改，并改用哈希存储
AUTH_USERNAME=zhuliang
AUTH_PASSWORD=zhuliang
# 登录 token 有效期（分钟）；token 存进程内存，后端重启即全体失效
AUTH_TOKEN_TTL_MINUTES=720
# 验证码有效期（秒）；验证码是一次性的（校验即作废）
CAPTCHA_TTL_SECONDS=120
# 【危险】仅本地自动化验收用：开启后取验证码接口会额外返回明文 code，验证码形同虚设。
# 默认 false；开启时后端启动会打 warning。生产环境绝不可开启。
AUTH_CAPTCHA_BYPASS=false

# ===== 测试库 =====
# 测试库连接串（pytest 独立库）
TEST_DATABASE_URL=postgresql+psycopg2://postgres:123456@localhost:5432/rag_kb_test

